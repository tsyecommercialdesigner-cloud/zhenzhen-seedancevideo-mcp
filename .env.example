# Copy to the actual MCP Server installation directory as .env; fill the empty key.
ZHENZHEN_SEEDANCE_API_KEY=
# local blocks provider/download network; provider explicitly enables new submissions.
ZHENZHEN_SEEDANCE_EXECUTION_MODE=local
# Optional local absolute output path:
# ZHENZHEN_SEEDANCE_OUTPUT_DIR=D:\Videos\Seedance
# Optional explicit proxy and CA:
# ZHENZHEN_SEEDANCE_PROXY_URL=http://127.0.0.1:7890
# ZHENZHEN_SEEDANCE_PROXY_BYPASS=localhost,127.0.0.1
# ZHENZHEN_SEEDANCE_CA_FILE=C:\Certificates\trusted-ca.pem
ZHENZHEN_SEEDANCE_GENERATION_CONCURRENCY=3
ZHENZHEN_SEEDANCE_QUERY_CONCURRENCY=4
ZHENZHEN_SEEDANCE_DOWNLOAD_CONCURRENCY=2
